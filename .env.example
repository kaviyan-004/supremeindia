# MongoDB
MONGODB_URI=your_mongodb_atlas_connection_string

# Razorpay (test mode keys to start — switch to live keys after KYC)
RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_test_key_id

# App & Security Secrets
NEXT_PUBLIC_SITE_NAME=Supreme India
JWT_SECRET=your_random_64_character_hex_secret_here
ADMIN_EMAIL=admin@supremeindia.com
ADMIN_PASSWORD=your_secure_admin_password

# Image storage (Vercel Blob). Added automatically when you connect a Blob store to the Vercel project;
# only needed locally if you want to test uploads.
BLOB_READ_WRITE_TOKEN=

# Private store for customer artwork (Custom Print). Create a second Blob store set to PRIVATE and
# connect it with the env-var prefix ARTWORK_BLOB so Vercel adds this variable.
ARTWORK_BLOB_READ_WRITE_TOKEN=
